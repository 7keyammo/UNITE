# Hosted providers are optional. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider default models
DAQAUNTUM_OPENAI_MODEL=gpt-5.6-luna
DAQAUNTUM_ANTHROPIC_MODEL=claude-sonnet-5
DAQAUNTUM_OLLAMA_MODEL=gemma3
DAQAUNTUM_OLLAMA_URL=http://localhost:11434

# Legacy/global override. auto | openai | anthropic | ollama | mock
DAQAUNTUM_PROVIDER=auto

# Optional role-specific overrides. These win over DAQAUNTUM_PROVIDER.
DAQAUNTUM_PLANNER_PROVIDER=
DAQAUNTUM_PLANNER_MODEL=
DAQAUNTUM_EXECUTOR_PROVIDER=
DAQAUNTUM_EXECUTOR_MODEL=
DAQAUNTUM_CRITIC_PROVIDER=
DAQAUNTUM_CRITIC_MODEL=

# Optional v0.2.3 model-policy overrides
DAQAUNTUM_POLICY_ENABLED=true
DAQAUNTUM_LOCAL_ONLY_SENSITIVE=true
DAQAUNTUM_SECOND_OPINION=true

# Optional: used only by an explicitly connected Apify dataset connector.
APIFY_TOKEN=

# v0.4.0 optional integrations
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
DAQAUNTUM_POSTGRES_DSN=
FLUX_MCP_URL=

# Optional local multimodal model
DAQAUNTUM_VISION_OLLAMA_MODEL=

# Optional generic MQTT / IoT bus
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
